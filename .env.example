# Model: a Gemini model id (needs GOOGLE_API_KEY) or litellm/<provider>/<model>, e.g. litellm/anthropic/claude-sonnet-4-5
MODEL=gemini-2.5-flash
GOOGLE_API_KEY=changeme
# ANTHROPIC_API_KEY=changeme   # when MODEL=litellm/anthropic/...
# OPENROUTER_API_KEY=changeme  # when MODEL=litellm/openrouter/..., e.g. litellm/openrouter/google/gemini-2.5-flash
# Extra JSON sent with every LiteLLM request, e.g. the Jev router plugin (MODEL=litellm/openrouter/typesafe/jev-router):
# MODEL_EXTRA_BODY={"plugins":[{"id":"jev-router","cost_tier":"low","excluded_models":["anthropic/claude-opus*"]}]}

# Path to the built mcp-wazuh server (node dist/index.js)
MCP_WAZUH_PATH=../mcp-wazuh/dist/index.js
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=mcp-reader
WAZUH_API_PASSWORD=changeme
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=mcp-reader
WAZUH_INDEXER_PASSWORD=changeme
# TLS_INSECURE=true            # lab only

MAX_STEPS=6
INVESTIGATION_TIMEOUT_S=120
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=6
TOKEN_BUDGET=60000
AUDIT_LOG_PATH=./audit/audit.jsonl
INCIDENTS_DIR=./incidents
