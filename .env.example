# Model. Default: one fixed model via OpenRouter, reproducible results.
MODEL=litellm/openrouter/google/gemini-2.5-flash
OPENROUTER_API_KEY=changeme
# Economy: let the Jev router pick a cheap model per call (not reproducible). Replace MODEL above with:
# MODEL=litellm/openrouter/typesafe/jev-router
# MODEL_EXTRA_BODY='{"plugins":[{"id":"jev-router","cost_tier":"low","excluded_models":["anthropic/claude-opus*","openai/gpt-6*"]}]}'
# Other providers: MODEL=gemini-2.5-flash + GOOGLE_API_KEY, or MODEL=litellm/anthropic/<model> + ANTHROPIC_API_KEY

# Path to the built mcp-wazuh server (node dist/index.js)
MCP_WAZUH_PATH=../mcp-wazuh/dist/index.js
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=mcp-reader
WAZUH_API_PASSWORD=changeme
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=mcp-reader
WAZUH_INDEXER_PASSWORD=changeme
# TLS_INSECURE=true            # lab only

MAX_STEPS=6
INVESTIGATION_TIMEOUT_S=120
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=6
TOKEN_BUDGET=60000
AUDIT_LOG_PATH=./audit/audit.jsonl
INCIDENTS_DIR=./incidents
